# DeepSeek V4 amalgamation build — x86-64/aarch64 Linux, Windows/MSYS2, macOS arm64.
# NOTE: the historical comment claimed a GNU ld -Wl,--wrap dependency; there is none
# in this file (LDFLAGS are just -lm -fopenmp -pthread). macOS support added by
# mirroring c/Makefile's Apple-clang handling: -mcpu instead of -march, Homebrew
# libomp for OpenMP, no _GNU_SOURCE.
# `make check` (the parent Makefile gates COLI_V4_SUPPORTED).

ifeq ($(OS),Windows_NT)
IS_WIN := 1
UNAME_S :=
UNAME_M :=
else
IS_WIN :=
UNAME_S := $(shell uname -s 2>/dev/null)
UNAME_M := $(shell uname -m 2>/dev/null)
endif

COLI_V4_OK :=
ifeq ($(IS_WIN),1)
COLI_V4_OK := 1
else ifeq ($(UNAME_S),Linux)
ifneq (,$(filter x86_64 amd64 aarch64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
endif
else ifeq ($(UNAME_S),Darwin)
ifneq (,$(filter x86_64 arm64,$(UNAME_M)))
COLI_V4_OK := 1
IS_DARWIN := 1
endif
endif

ifneq ($(COLI_V4_OK),1)
$(error Makefile.deepseek-v4 supports only x86-64/aarch64 Linux, Windows/MSYS2, and macOS)
endif

ifneq ($(IS_DARWIN),)
# --- macOS (Apple clang) ---
# No -D_GNU_SOURCE (glibc-only). arm64 clang uses -mcpu, not -march.
# OpenMP comes from Homebrew libomp exactly as in c/Makefile.
CC = clang
V4_OMPDIR := $(shell brew --prefix libomp 2>/dev/null)
ifneq ($(and $(V4_OMPDIR),$(wildcard $(V4_OMPDIR)/include/omp.h),$(wildcard $(V4_OMPDIR)/lib/libomp.*)),)
V4_OMPC = -Xclang -fopenmp -I$(V4_OMPDIR)/include
V4_OMPL = -L$(V4_OMPDIR)/lib -lomp
else
$(warning libomp not found: DeepSeek V4 will build single-threaded. brew install libomp)
V4_OMPC =
V4_OMPL =
endif
CFLAGS = -D_DARWIN_C_SOURCE -D_FILE_OFFSET_BITS=64 -O3 $(V4_OMPC) -pthread \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
ifneq ($(ARCH),)
ifeq ($(UNAME_M),arm64)
CFLAGS += -mcpu=$(ARCH)
else
CFLAGS += -march=$(ARCH)
endif
endif
LDFLAGS = -lm $(V4_OMPL) -pthread
V4_BINARY := deepseek_v4
else ifneq ($(IS_WIN),)
CC = gcc
ARCH ?= x86-64-v3
CFLAGS = -D_GNU_SOURCE -D_FILE_OFFSET_BITS=64 -O3 -march=$(ARCH) -fopenmp \
	-include pthread.h -Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -static -pthread
V4_BINARY := deepseek_v4.exe
else
CC = gcc
ARCH ?= native
CFLAGS = -D_GNU_SOURCE -O3 -march=$(ARCH) -fopenmp -pthread -include pthread.h \
	-Wall -Wextra -Wno-unused-parameter \
	-Wno-misleading-indentation -Wno-unused-function \
	-DCOLI_V4_MAX_PIN_SLOTS_PER_LAYER=16 \
	-DCOLI_V4_PIN_RAMP_REQUESTS=24
LDFLAGS = -lm -fopenmp -pthread
V4_BINARY := deepseek_v4
endif

LTO ?= 1
ifeq ($(LTO),1)
CFLAGS += -flto
LDFLAGS += -flto
endif

# METAL=1 is an opt-in Darwin-only V4 backend.  Keep it in a separate
# Objective-C++ object so none of the 26 C amalgamation units sees Metal
# headers or COLI_METAL.  The shader is built offline and embedded as source;
# runtime initialization may therefore use the metallib or compile the same
# source with newLibraryWithSource:.
METAL ?= 0
V4_METAL_BACKEND_OBJ := backend_metal_v4.o
V4_METAL_OBJ :=
V4_METAL_BUILD_DIR := build/metal-v4
V4_METAL_SOURCES := $(sort $(wildcard metal/coli_v4_*.metal))
V4_METAL_AIR := $(patsubst metal/%.metal,$(V4_METAL_BUILD_DIR)/%.air,$(V4_METAL_SOURCES))
V4_METAL_LIB :=
V4_METAL_LIB_FILE := $(V4_METAL_BUILD_DIR)/deepseek_v4.metallib
V4_METAL_SOURCE_HEADER := $(V4_METAL_BUILD_DIR)/deepseek_v4_source.h
METALXX ?= clang++ -x objective-c++ -std=gnu++17 -fobjc-arc -O3
METALC ?= xcrun -sdk macosx metal
METALLIB ?= xcrun -sdk macosx metallib
ifeq ($(METAL),1)
ifeq ($(IS_DARWIN),)
$(error METAL=1 is supported only on macOS)
endif
V4_METAL_OBJ := $(V4_METAL_BACKEND_OBJ)
V4_METAL_LIB := $(V4_METAL_LIB_FILE)
CFLAGS += -DCOLI_V4_METAL_SEAM
LDFLAGS += -framework Metal -framework Foundation -lc++
endif

include Makefile.deepseek-v4.units

TARGET_OBJS = $(addsuffix .o,$(V4_TARGET_UNITS))
TEST_UNIT_OBJS = $(addsuffix .o,$(V4_TEST_UNITS))
V4_OBJS = $(TARGET_OBJS) $(V4_METAL_OBJ)

.PHONY: deepseek-v4 deepseek-v4-clean deepseek-v4-test-objs deepseek-v4-metal-lib
deepseek-v4: $(V4_BINARY)

$(V4_BINARY): $(V4_OBJS) $(V4_METAL_LIB)
	$(CC) $(V4_OBJS) -o $@ $(LDFLAGS)

$(TARGET_OBJS) $(TEST_UNIT_OBJS): %.o: deepseek_v4.c deepseek_v4.h \
	deepseek_v4_internal.h deepseek_v4_dspark.inc st.h json.h compat.h tensor.h quant.h \
	native_quant.h native_quant_batch.h native_quant_dual.h \
	native_quant_fp4_rows16.h backend_metal_v4_seam.h
	$(CC) $(CFLAGS) -D$* -c deepseek_v4.c -o $@

$(V4_METAL_BUILD_DIR):
	mkdir -p $@

$(V4_METAL_BUILD_DIR)/%.air: metal/%.metal | $(V4_METAL_BUILD_DIR)
	$(METALC) -c $< -o $@

$(V4_METAL_LIB_FILE): $(V4_METAL_AIR)
	$(METALLIB) $^ -o $@

$(V4_METAL_SOURCE_HEADER): $(V4_METAL_SOURCES) | $(V4_METAL_BUILD_DIR)
	{ printf '%s\n' '#ifndef COLI_V4_METAL_STUB_SOURCE_H' '#define COLI_V4_METAL_STUB_SOURCE_H' \
		'static const unsigned char coli_v4_metal_source[] = {'; \
		cat $^ | xxd -i; \
		printf '%s\n' '};' \
			'static const unsigned long coli_v4_metal_source_len = sizeof(coli_v4_metal_source);' \
			'#endif'; } > $@

$(V4_METAL_BACKEND_OBJ): backend_metal_v4.mm backend_metal_v4.h backend_metal_v4_seam.h $(V4_METAL_SOURCE_HEADER)
	$(METALXX) -DCOLI_METAL -DCOLI_V4_DEFAULT_METALLIB='"$(V4_METAL_LIB_FILE)"' -c $< -o $@

deepseek-v4-metal-lib: $(V4_METAL_LIB_FILE)

deepseek-v4-test-objs: $(TEST_UNIT_OBJS)

deepseek-v4-clean:
	rm -f $(V4_BINARY) $(TARGET_OBJS) $(TEST_UNIT_OBJS) $(V4_METAL_BACKEND_OBJ)
	rm -rf $(V4_METAL_BUILD_DIR)
