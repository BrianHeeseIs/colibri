# --- model weights: NEVER commit ---
models/
*.safetensors
*.gguf

# --- local build artifacts (make install PREFIX=.) ---
bin/
libexec/
c/colibri
c/olmoe
c/inkling
c/kimi_k3
c/*.o
web/dist/
web/node_modules/

# --- python ---
__pycache__/
*.pyc
.venv-convert/

# --- agent/session state ---
.omo/

# --- validation: keep harnesses + small JSON evidence, drop runtime noise ---
validation/**/download.log
validation/**/aria2.session
validation/**/*.safetensors.aria2

# --- compiled test/bench/fuzz binaries (extensionless; sources stay tracked) ---
c/tests/test_*
!c/tests/test_*.c
!c/tests/test_*.cu
!c/tests/test_*.mm
!c/tests/test_*.py
c/tests/bench_*
!c/tests/bench_*.c
c/tests/fuzz_*
!c/tests/fuzz_*.c
web/*.tsbuildinfo

# --- v4 build artifacts ---
c/deepseek_v4
c/deepseek_v4.exe
c/build/
c/*.orig

# --- validation: binaries + runtime logs are noise; sources/CSV evidence stay ---
validation/metal/probe_*
!validation/metal/probe_*.m
validation/metal/bench_*
!validation/metal/bench_*.m
validation/**/*.log
